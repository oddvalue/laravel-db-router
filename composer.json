{
    "name": "oddvalue/laravel-db-router",
    "type": "library",
    "description": "Routing through the database in Laravel",
    "keywords": [
        "oddvalue",
        "laravel-db-router"
    ],
    "homepage": "https://github.com/oddvalue/laravel-db-router",
    "license": "MIT",
    "authors": [
        {
            "name": "Jim Hollington",
            "email": "jim@oddvalue.co.uk",
            "homepage": "https://github.com/oddvalue",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "~8.3|~8.4",
        "driftingly/rector-laravel": "^2.1",
        "laravel/framework": "~12",
        "oddvalue/link-builder": "^2.0"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^10",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-laravel": "^4.0",
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.0",
        "rector/rector": "^2.2",
        "squizlabs/php_codesniffer": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Oddvalue\\DbRouter\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Oddvalue\\DbRouter\\": "tests",
            "Oddvalue\\DbRouter\\Test\\": "tests/app"
        }
    },
    "scripts": {
        "test": "pest",
        "check-style": "phpcs src tests",
        "fix-style": "phpcbf src tests",
        "phpstan": "phpstan analyse -c phpstan.neon.dist",
        "rector": "rector process",
        "rector:dry-run": "rector process --dry-run"
    },
    "extra": {
        "branch-alias": {
            "dev-master": "1.0-dev"
        },
        "laravel": {
            "providers": [
                "Oddvalue\\DbRouter\\DbRouterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
